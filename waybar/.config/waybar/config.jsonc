{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "reload_style_on_change": true,
  "font": "JetBrainsMono Nerd Font 15",

  "modules-left": [
    "sway/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "custom/battery",
    "tray"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "●",
      "2": "●",
      "3": "●",
      "4": "●",
      "5": "●",
      "urgent": "●",
      "default": "○"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "clock": {
    "format": " {:%H:%M  •  %a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1
    }
  },

  "cpu": {
    "interval": 5,
    "format": "󰍛 {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 10,
    "format": "󰾔 {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  "custom/battery": {
    "exec": "~/.config/sway/scripts/battery-status",
    "interval": 10,
    "return-type": "json",
    "on-click": "~/.config/sway/scripts/inhibit-toggle",
    "on-click-right": "~/.config/sway/scripts/inhibit-toggle",
    "on-click-middle": "~/.config/sway/scripts/inhibit-toggle"
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰀂 {ipaddr}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
